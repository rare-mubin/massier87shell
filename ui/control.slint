// massier87shell — control panel ("quick settings"): toggle tiles, sliders, a media card and
// power buttons, plus Wi-Fi and Ethernet pages. Which tiles/sections show is configurable
// ([control] in the config, or Settings → Modules → Control panel).

import { Theme } from "bar.slint";
import { PowerAction } from "power.slint";

export struct ControlTile {
    id: string,
    icon: string,
    label: string,
    toggle: bool, // false = a plain action button
    active: bool,
    detail: bool, // has a ">" button that opens more options
}

export struct WifiItem {
    ssid: string,
    icon: string, // signal strength glyph
    secured: bool,
    connected: bool,
    saved: bool,
    needs-password: bool,
    enterprise: bool, // needs Windows' own sign-in
    connecting: bool,
}

export struct EthItem {
    name: string,
    description: string,
    connected: bool,
    ipv4: string,
    speed: string,
}

export struct AudioDevice {
    id: string,
    name: string,
    selected: bool, // the default device
}

export struct AppAudio {
    key: string,
    name: string,
    icon: image,
    has-icon: bool,
    volume: float,
    muted: bool,
}

component Glyph inherits Text {
    font-family: Theme.icon-font;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component Label inherits Text {
    font-family: Theme.font-family;
    font-size: 13px;
    vertical-alignment: center;
    overflow: elide;
    color: Theme.foreground;
}

component Hint inherits Text {
    font-family: Theme.font-family;
    font-size: 11px;
    vertical-alignment: center;
    overflow: elide;
    color: Theme.foreground-dim;
}

component Tile inherits Rectangle {
    in property <ControlTile> tile;
    callback clicked();
    callback details();
    border-radius: 14px;
    background: root.tile.active ? (ta.pressed ? Theme.accent.darker(0.15) : ta.has-hover ? Theme.accent.brighter(0.08) : Theme.accent)
        : (ta.pressed ? Theme.surface-hover.darker(0.1) : ta.has-hover ? Theme.surface-hover : Theme.surface);
    animate background { duration: 160ms * Theme.motion; }
    VerticalLayout {
        alignment: center;
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;
        Glyph {
            text: root.tile.icon;
            font-size: 18px;
            color: root.tile.active ? Theme.on-accent : Theme.foreground;
            animate color { duration: 160ms * Theme.motion; }
        }
        Text {
            text: root.tile.label;
            font-family: Theme.font-family;
            font-size: 11px;
            horizontal-alignment: center;
            overflow: elide;
            color: root.tile.active ? Theme.on-accent : Theme.foreground;
        }
    }
    // `pointer-event` instead of `clicked`: a press that moves a pixel or two still counts.
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && self.has-hover) {
                root.clicked();
            }
        }
    }
    if root.tile.detail: Rectangle {
        x: parent.width - self.width - 4px;
        y: 4px;
        width: 24px;
        height: 24px;
        border-radius: 8px;
        background: chevron.has-hover ? (root.tile.active ? Theme.on-accent.with-alpha(0.18) : Theme.foreground.with-alpha(0.10)) : transparent;
        Glyph {
            text: "\u{E76C}";
            font-size: 10px;
            color: root.tile.active ? Theme.on-accent : Theme.foreground-dim;
        }
        chevron := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && self.has-hover) {
                    root.details();
                }
            }
        }
    }
}
component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: 34px;
    in property <bool> dim;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: ta.pressed ? Theme.surface-hover.darker(0.1) : ta.has-hover ? Theme.surface-hover : transparent;
    Glyph {
        text: root.icon;
        font-size: 14px;
        color: root.dim ? Theme.foreground-dim : Theme.foreground;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A 0..100 slider track: click or drag to set, scroll to nudge.
component Track {
    in-out property <float> value;
    in property <length> thickness: 8px;
    callback changed(float);
    min-height: 20px;
    function set-from(px: length) {
        let v = round(clamp(px / root.width, 0, 1) * 100);
        if (v != root.value) {
            root.value = v;
            root.changed(v);
        }
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.thickness;
        border-radius: root.thickness / 2;
        background: Theme.surface-hover;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        height: root.thickness;
        width: parent.width * clamp(root.value, 0, 100) / 100;
        border-radius: root.thickness / 2;
        background: Theme.accent;
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
        scroll-event(e) => {
            let v = clamp(root.value + (e.delta-y > 0 ? 5 : -5), 0, 100);
            root.value = v;
            root.changed(v);
            return accept;
        }
    }
}

// Icon + track + value; drag or scroll to change. `detail` adds a ">" for more options.
component SliderRow {
    in property <string> icon;
    in-out property <float> value; // 0..100
    in property <bool> detail;
    callback changed(float);
    callback icon-clicked();
    callback details();
    height: 40px;
    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            width: 32px;
            border-radius: 10px;
            background: icon-ta.has-hover ? Theme.surface-hover : transparent;
            Glyph {
                text: root.icon;
                font-size: 15px;
                color: Theme.foreground;
            }
            icon-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.icon-clicked(); }
            }
        }
        Track {
            horizontal-stretch: 1;
            value <=> root.value;
            changed(v) => { root.changed(v); }
        }
        Text {
            text: "\{round(root.value)}%";
            width: 38px;
            font-family: Theme.font-family;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: Theme.foreground-dim;
        }
        if root.detail: Rectangle {
            width: 28px;
            border-radius: 9px;
            background: detail-ta.has-hover ? Theme.surface-hover : transparent;
            Glyph {
                text: "\u{E76C}";
                font-size: 11px;
                color: Theme.foreground-dim;
            }
            detail-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.details(); }
            }
        }
    }
}

// An output or input device; the default one is highlighted.
component DeviceRow inherits Rectangle {
    in property <AudioDevice> device;
    in property <string> icon;
    callback clicked();
    height: 36px;
    border-radius: 10px;
    background: root.device.selected ? Theme.accent.with-alpha(0.16) : ta.has-hover ? Theme.surface : transparent;
    animate background { duration: 120ms * Theme.motion; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        Glyph {
            text: root.icon;
            width: 20px;
            font-size: 14px;
            color: root.device.selected ? Theme.accent : Theme.foreground-dim;
        }
        Text {
            text: root.device.name;
            horizontal-stretch: 1;
            font-family: Theme.font-family;
            font-size: 12px;
            font-weight: root.device.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            color: Theme.foreground;
        }
        if root.device.selected: Glyph {
            text: "\u{E73E}";
            width: 16px;
            font-size: 12px;
            color: Theme.accent;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One app in the mixer: icon, name, slider, mute.
component AppRow {
    in property <AppAudio> app;
    callback changed(float);
    callback mute-clicked();
    height: 46px;
    HorizontalLayout {
        spacing: 10px;
        padding-left: 6px;
        VerticalLayout {
            alignment: center;
            width: 22px;
            if root.app.has-icon: Image {
                source: root.app.icon;
                width: 20px;
                height: 20px;
                opacity: root.app.muted ? 0.45 : 1;
            }
            if !root.app.has-icon: Glyph {
                text: "\u{E7F5}";
                font-size: 15px;
                color: Theme.foreground-dim;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.app.name;
                font-family: Theme.font-family;
                font-size: 11px;
                overflow: elide;
                color: root.app.muted ? Theme.foreground-dim : Theme.foreground;
            }
            Track {
                thickness: 6px;
                min-height: 16px;
                value: root.app.volume;
                changed(v) => { root.changed(v); }
            }
        }
        Text {
            text: "\{round(root.app.volume)}%";
            width: 34px;
            font-family: Theme.font-family;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: Theme.foreground-dim;
        }
        VerticalLayout {
            alignment: center;
            RoundButton {
                size: 30px;
                icon: root.app.muted ? "\u{E74F}" : "\u{E767}";
                dim: root.app.muted;
                clicked => { root.mute-clicked(); }
            }
        }
    }
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    min-width: row.preferred-width + 28px;
    border-radius: 10px;
    opacity: root.enabled ? 1 : 0.5;
    background: root.primary ? (ta.pressed ? Theme.accent.darker(0.15) : ta.has-hover ? Theme.accent.brighter(0.08) : Theme.accent)
        : (ta.pressed ? Theme.surface-hover.darker(0.1) : ta.has-hover ? Theme.surface-hover : Theme.surface.brighter(0.04));
    row := HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if root.icon != "": Glyph {
            text: root.icon;
            font-size: 12px;
            color: root.primary ? Theme.on-accent : Theme.foreground;
        }
        Text {
            text: root.text;
            font-family: Theme.font-family;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            color: root.primary ? Theme.on-accent : Theme.foreground;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Switch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Theme.accent : Theme.surface-hover;
    border-width: root.checked ? 0px : 1px;
    border-color: Theme.foreground-dim.with-alpha(0.5);
    animate background { duration: 150ms * Theme.motion; }
    Rectangle {
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.checked ? Theme.on-accent : Theme.foreground-dim;
        animate x { duration: 150ms * Theme.motion; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Header of a sub page: back arrow, title, and whatever goes on the right.
component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <bool> can-go-back: true;
    callback back();
    spacing: 6px;
    if root.can-go-back: RoundButton {
        icon: "\u{E72B}";
        clicked => { root.back(); }
    }
    Text {
        text: root.title;
        font-family: Theme.font-family;
        font-size: 15px;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-stretch: 1;
        color: Theme.foreground;
    }
    @children
}

component NetworkRow inherits Rectangle {
    in property <WifiItem> net;
    in property <bool> expanded;
    callback toggle-expanded();
    callback connect(string); // password ("" = none needed)
    callback disconnect();
    callback properties();
    callback windows-connect();

    border-radius: 12px;
    background: root.expanded || root.net.connected ? Theme.surface : head-ta.has-hover ? Theme.surface.with-alpha(0.6) : transparent;
    height: body.preferred-height;
    animate background { duration: 120ms * Theme.motion; }

    body := VerticalLayout {
        padding: 6px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            height: 38px;
            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    width: 22px;
                    Glyph {
                        text: root.net.icon;
                        font-size: 16px;
                        color: root.net.connected ? Theme.accent : Theme.foreground;
                    }
                    if root.net.secured: Glyph {
                        x: parent.width - 8px;
                        y: parent.height / 2 + 1px;
                        width: 10px;
                        height: 10px;
                        text: "\u{E72E}";
                        font-size: 9px;
                        color: Theme.foreground-dim;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 1px;
                    Label {
                        text: root.net.ssid;
                        font-weight: root.net.connected ? 700 : 400;
                    }
                    Hint {
                        text: root.net.connecting ? "Connecting…"
                            : root.net.connected ? (root.net.secured ? "Connected, secured" : "Connected")
                            : root.net.enterprise ? "Secured (sign-in)"
                            : root.net.secured ? (root.net.saved ? "Secured, saved" : "Secured") : "Open";
                        color: root.net.connecting || root.net.connected ? Theme.accent : Theme.foreground-dim;
                    }
                }
            }
            head-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle-expanded(); }
            }
        }

        if root.expanded && root.net.connected: HorizontalLayout {
            alignment: end;
            spacing: 8px;
            PillButton {
                text: "Properties";
                icon: "\u{E946}";
                clicked => { root.properties(); }
            }
            PillButton {
                text: "Disconnect";
                clicked => { root.disconnect(); }
            }
        }

        if root.expanded && !root.net.connected && root.net.enterprise && !root.net.saved: HorizontalLayout {
            alignment: end;
            PillButton {
                text: "Connect in Windows";
                icon: "\u{E8A7}";
                primary: true;
                clicked => { root.windows-connect(); }
            }
        }

        if root.expanded && !root.net.connected && root.net.needs-password: VerticalLayout {
            spacing: 8px;
            Rectangle {
                height: 34px;
                border-radius: 10px;
                background: Theme.background;
                border-width: 1px;
                border-color: password.has-focus ? Theme.accent : Theme.surface-hover;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 4px;
                    password := TextInput {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        input-type: show.checked ? InputType.text : InputType.password;
                        font-family: Theme.font-family;
                        font-size: 13px;
                        color: Theme.foreground;
                        selection-background-color: Theme.accent.with-alpha(0.4);
                        accepted => { root.connect(self.text); }
                        init => { self.focus(); }
                    }
                    show := RoundButton {
                        property <bool> checked;
                        size: 28px;
                        icon: "\u{E7B3}";
                        dim: !self.checked;
                        clicked => { self.checked = !self.checked; }
                    }
                }
                if password.text == "": Hint {
                    x: 10px;
                    text: "Network password";
                }
            }
            HorizontalLayout {
                alignment: end;
                PillButton {
                    text: root.net.connecting ? "Connecting…" : "Connect";
                    primary: true;
                    enabled: !root.net.connecting && password.text != "";
                    clicked => { root.connect(password.text); }
                }
            }
        }

        if root.expanded && !root.net.connected && !root.net.needs-password && !(root.net.enterprise && !root.net.saved): HorizontalLayout {
            alignment: end;
            PillButton {
                text: root.net.connecting ? "Connecting…" : "Connect";
                primary: true;
                enabled: !root.net.connecting;
                clicked => { root.connect(""); }
            }
        }
    }
}

// Round power button; destructive ones need a second click.
component PowerButton inherits Rectangle {
    in property <string> icon;
    in property <bool> armed;
    callback clicked();
    callback hovered(bool);
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: root.armed ? Theme.urgent : ta.pressed ? Theme.surface-hover.darker(0.1) : ta.has-hover ? Theme.surface-hover : Theme.surface;
    animate background { duration: 140ms * Theme.motion; }
    Glyph {
        text: root.icon;
        font-size: 16px;
        color: root.armed ? Theme.background : Theme.foreground;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }
}

export component ControlPanel inherits Window {
    title: "massier87shell — Control panel";
    no-frame: true;
    always-on-top: true;
    width: 360px;
    height: layout.preferred-height;
    background: Theme.background.with-alpha(Theme.glass);

    in property <[ControlTile]> tiles;
    in property <bool> show-volume;
    in property <bool> show-brightness; // false also when the display has no brightness control
    in property <bool> show-media;
    in property <bool> show-power;
    in property <bool> can-hibernate;
    in-out property <float> volume;
    in property <bool> muted;
    in-out property <float> brightness;
    in property <bool> media-active;
    in property <bool> media-playing;
    in property <string> media-title;
    in property <string> media-artist;
    in-out property <bool> open;
    // "" = the main page, "wifi" or "ethernet".
    in-out property <string> page;

    // Wi-Fi page
    in property <bool> wifi-available;
    in-out property <bool> wifi-on;
    in property <[WifiItem]> networks;
    in property <bool> scanning;
    in property <string> wifi-message; // an error, shown above the list
    in property <bool> wifi-blocked; // Location is off: Windows hides the list
    in-out property <string> expanded; // the network whose options are open

    // Ethernet page
    in property <[EthItem]> adapters;

    // Sound page (also opened on its own by the bar's volume module: `standalone`)
    in property <bool> standalone;
    in property <[AudioDevice]> outputs;
    in property <[AudioDevice]> inputs;
    in property <[AppAudio]> apps;
    in-out property <float> mic-volume;
    in property <bool> mic-muted;
    in property <bool> has-mic;

    callback tile-clicked(string);
    callback tile-details(string);
    callback volume-changed(float);
    callback brightness-changed(float);
    callback mute-clicked();
    callback media-prev();
    callback media-toggle();
    callback media-next();
    callback open-settings();
    callback dismiss();
    callback power(PowerAction);
    callback wifi-toggled(bool);
    callback wifi-scan();
    callback wifi-connect(string, string); // (ssid, password)
    callback wifi-disconnect();
    callback wifi-settings();
    callback wifi-windows(); // Windows' own network list (for sign-in networks)
    callback location-settings();
    callback ethernet-settings();
    callback adapter-options();
    callback output-selected(string);
    callback input-selected(string);
    callback app-volume-changed(string, float);
    callback app-mute-clicked(string, bool);
    callback mic-volume-changed(float);
    callback mic-mute-clicked();
    callback sound-settings();
    callback volume-mixer();

    property <length> tile-w: (root.width - 32px - 16px) / 3;
    property <length> tile-h: 72px;
    // Power buttons: which one waits for a second click, and which one is hovered.
    in-out property <int> armed: -1; // reset by Rust when the panel opens
    property <int> hover: -1;
    property <[string]> power-names: ["Lock", "Sleep", "Sign out", "Restart", "Shut down", "Hibernate"];

    function press(index: int, action: PowerAction) {
        if (index < 2 || root.armed == index) {
            root.armed = -1;
            root.power(action);
        } else {
            root.armed = index;
            disarm.running = true;
            disarm.restart();
        }
    }

    // Un-arms a power button that wasn't confirmed in time.
    disarm := Timer {
        interval: 3500ms;
        running: false;
        triggered => {
            root.armed = -1;
            self.running = false;
        }
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                if (root.armed >= 0) {
                    root.armed = -1;
                } else if (root.page != "" && !root.standalone) {
                    root.page = "";
                } else {
                    root.dismiss();
                }
                return accept;
            }
            reject
        }
    }

    Rectangle {
        opacity: root.open ? 1 : 0;
        y: root.open ? 0 : -10px;
        animate opacity { duration: 180ms * Theme.motion; }
        animate y { duration: 260ms * Theme.motion; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }

        layout := VerticalLayout {
            padding: 16px;
            spacing: 14px;

            // ================= main page =================
            if root.page == "": HorizontalLayout {
                Text {
                    text: "Quick settings";
                    font-family: Theme.font-family;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    color: Theme.foreground;
                }
                RoundButton {
                    icon: "\u{E713}";
                    clicked => { root.open-settings(); }
                }
            }

            // Tiles, three per row.
            if root.page == "" && root.tiles.length > 0: Rectangle {
                height: ceil(root.tiles.length / 3) * (root.tile-h + 8px) - 8px;
                for t[i] in root.tiles: Tile {
                    tile: t;
                    x: mod(i, 3) * (root.tile-w + 8px);
                    y: floor(i / 3) * (root.tile-h + 8px);
                    width: root.tile-w;
                    height: root.tile-h;
                    clicked => { root.tile-clicked(t.id); }
                    details => { root.tile-details(t.id); }
                }
            }

            if root.page == "" && (root.show-volume || root.show-brightness): VerticalLayout {
                spacing: 2px;
                if root.show-volume: SliderRow {
                    icon: root.muted ? "\u{E74F}" : "\u{E767}";
                    value <=> root.volume;
                    changed(v) => { root.volume-changed(v); }
                    icon-clicked => { root.mute-clicked(); }
                    detail: true;
                    details => { root.tile-details("audio"); }
                }
                if root.show-brightness: SliderRow {
                    icon: "\u{E706}";
                    value <=> root.brightness;
                    changed(v) => { root.brightness-changed(v); }
                }
            }

            // ================= Sound page =================
            if root.page == "audio": PageHeader {
                title: "Sound";
                can-go-back: !root.standalone;
                back => { root.page = ""; }
                RoundButton {
                    icon: "\u{E713}";
                    clicked => { root.sound-settings(); }
                }
            }

            if root.page == "audio": Flickable {
                height: min(sound.preferred-height, 560px);
                content-height: sound.preferred-height;
                sound := VerticalLayout {
                    width: parent.width;
                    spacing: 4px;

                    Hint { text: "OUTPUT"; font-weight: 700; height: 20px; }
                    for d in root.outputs: DeviceRow {
                        device: d;
                        icon: "\u{E7F5}";
                        clicked => { root.output-selected(d.id); }
                    }
                    SliderRow {
                        icon: root.muted ? "\u{E74F}" : "\u{E767}";
                        value <=> root.volume;
                        changed(v) => { root.volume-changed(v); }
                        icon-clicked => { root.mute-clicked(); }
                    }

                    Rectangle { height: 6px; }
                    Hint { text: "APPS"; font-weight: 700; height: 20px; }
                    if root.apps.length == 0: Hint {
                        text: "No apps are playing sound";
                        height: 32px;
                        horizontal-alignment: center;
                    }
                    for a in root.apps: AppRow {
                        app: a;
                        changed(v) => { root.app-volume-changed(a.key, v); }
                        mute-clicked => { root.app-mute-clicked(a.key, !a.muted); }
                    }

                    if root.has-mic: Rectangle { height: 6px; }
                    if root.has-mic: Hint { text: "INPUT"; font-weight: 700; height: 20px; }
                    for d in root.inputs: DeviceRow {
                        device: d;
                        icon: "\u{E720}";
                        clicked => { root.input-selected(d.id); }
                    }
                    if root.has-mic: SliderRow {
                        icon: root.mic-muted ? "\u{EC54}" : "\u{E720}";
                        value <=> root.mic-volume;
                        changed(v) => { root.mic-volume-changed(v); }
                        icon-clicked => { root.mic-mute-clicked(); }
                    }
                }
            }

            if root.page == "audio": HorizontalLayout {
                alignment: end;
                spacing: 8px;
                PillButton {
                    text: "Volume mixer";
                    icon: "\u{E9E9}";
                    clicked => { root.volume-mixer(); }
                }
                PillButton {
                    text: "Sound settings";
                    icon: "\u{E713}";
                    clicked => { root.sound-settings(); }
                }
            }

            if root.page == "" && root.show-media && root.media-active: Rectangle {
                height: 64px;
                border-radius: 14px;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 8px;
                    spacing: 10px;
                    Glyph {
                        text: "\u{E8D6}";
                        font-size: 18px;
                        width: 20px;
                        color: Theme.accent;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.media-title;
                            font-family: Theme.font-family;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                            color: Theme.foreground;
                        }
                        Text {
                            text: root.media-artist;
                            font-family: Theme.font-family;
                            font-size: 11px;
                            overflow: elide;
                            color: Theme.foreground-dim;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            RoundButton { icon: "\u{E892}"; clicked => { root.media-prev(); } }
                            RoundButton { icon: root.media-playing ? "\u{E769}" : "\u{E768}"; clicked => { root.media-toggle(); } }
                            RoundButton { icon: "\u{E893}"; clicked => { root.media-next(); } }
                        }
                    }
                }
            }

            if root.page == "" && root.show-power: VerticalLayout {
                spacing: 8px;
                Rectangle {
                    height: 1px;
                    background: Theme.surface;
                }
                HorizontalLayout {
                    alignment: space-between;
                    PowerButton {
                        icon: "\u{E72E}";
                        clicked => { root.press(0, PowerAction.lock); }
                        hovered(h) => { root.hover = h ? 0 : -1; }
                    }
                    PowerButton {
                        icon: "\u{E708}";
                        clicked => { root.press(1, PowerAction.sleep); }
                        hovered(h) => { root.hover = h ? 1 : -1; }
                    }
                    PowerButton {
                        icon: "\u{F3B1}";
                        armed: root.armed == 2;
                        clicked => { root.press(2, PowerAction.sign-out); }
                        hovered(h) => { root.hover = h ? 2 : -1; }
                    }
                    PowerButton {
                        icon: "\u{E777}";
                        armed: root.armed == 3;
                        clicked => { root.press(3, PowerAction.restart); }
                        hovered(h) => { root.hover = h ? 3 : -1; }
                    }
                    PowerButton {
                        icon: "\u{E7E8}";
                        armed: root.armed == 4;
                        clicked => { root.press(4, PowerAction.shutdown); }
                        hovered(h) => { root.hover = h ? 4 : -1; }
                    }
                    if root.can-hibernate: PowerButton {
                        icon: "\u{E9F3}";
                        armed: root.armed == 5;
                        clicked => { root.press(5, PowerAction.hibernate); }
                        hovered(h) => { root.hover = h ? 5 : -1; }
                    }
                }
                Text {
                    text: root.armed >= 0 ? "Click again to " + root.power-names[root.armed].to-lowercase()
                        : root.hover >= 0 ? root.power-names[root.hover] : " ";
                    height: 16px;
                    font-family: Theme.font-family;
                    font-size: 11px;
                    font-weight: root.armed >= 0 ? 700 : 400;
                    horizontal-alignment: center;
                    color: root.armed >= 0 ? Theme.urgent : Theme.foreground-dim;
                }
            }

            // ================= Wi-Fi page =================
            if root.page == "wifi": PageHeader {
                title: "Wi-Fi";
                back => { root.page = ""; }
                RoundButton {
                    icon: "\u{E72C}";
                    dim: root.scanning || !root.wifi-on;
                    clicked => { root.wifi-scan(); }
                }
                VerticalLayout {
                    alignment: center;
                    padding-left: 6px;
                    Switch {
                        checked <=> root.wifi-on;
                        toggled(on) => { root.wifi-toggled(on); }
                    }
                }
            }

            if root.page == "wifi" && root.wifi-message != "": Rectangle {
                height: msg.preferred-height + 16px;
                border-radius: 10px;
                background: Theme.urgent.with-alpha(0.15);
                msg := Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: root.wifi-message;
                    wrap: word-wrap;
                    font-family: Theme.font-family;
                    font-size: 12px;
                    color: Theme.urgent;
                }
            }

            // Windows 11 hides the network list from apps unless Location is on.
            if root.page == "wifi" && root.wifi-on && root.wifi-blocked: Rectangle {
                border-radius: 12px;
                background: Theme.surface;
                height: blocked.preferred-height;
                blocked := VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        Glyph {
                            text: "\u{E81D}";
                            font-size: 18px;
                            width: 22px;
                            color: Theme.accent;
                        }
                        Text {
                            text: "Windows only shows Wi-Fi networks to apps when Location is on. Turn on Location and \"Let desktop apps access your location\", or pick a network in Windows' own list.";
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            font-family: Theme.font-family;
                            font-size: 12px;
                            color: Theme.foreground;
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        PillButton {
                            text: "Windows' list";
                            icon: "\u{E701}";
                            clicked => { root.wifi-windows(); }
                        }
                        PillButton {
                            text: "Location settings";
                            icon: "\u{E81D}";
                            primary: true;
                            clicked => { root.location-settings(); }
                        }
                    }
                }
            }

            if root.page == "wifi" && !(root.wifi-on && root.wifi-blocked): Rectangle {
                height: !root.wifi-on || root.networks.length == 0 ? 90px : min(list.preferred-height, 330px);
                if !root.wifi-available: Hint {
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "No Wi-Fi adapter found";
                }
                if root.wifi-available && !root.wifi-on: Hint {
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "Wi-Fi is off";
                }
                if root.wifi-available && root.wifi-on && root.networks.length == 0: Hint {
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "Looking for networks…";
                }
                Flickable {
                    visible: root.wifi-on;
                    content-height: list.preferred-height;
                    list := VerticalLayout {
                        width: parent.width;
                        spacing: 4px;
                        for n in root.networks: NetworkRow {
                            net: n;
                            expanded: root.expanded == n.ssid;
                            toggle-expanded => { root.expanded = root.expanded == n.ssid ? "" : n.ssid; }
                            connect(pw) => { root.wifi-connect(n.ssid, pw); }
                            disconnect => { root.wifi-disconnect(); }
                            properties => { root.wifi-settings(); }
                            windows-connect => { root.wifi-windows(); }
                        }
                    }
                }
            }

            if root.page == "wifi": HorizontalLayout {
                alignment: end;
                spacing: 8px;
                PillButton {
                    text: "More Wi-Fi settings";
                    icon: "\u{E713}";
                    clicked => { root.wifi-settings(); }
                }
            }

            // ================= Ethernet page =================
            if root.page == "ethernet": PageHeader {
                title: "Ethernet";
                back => { root.page = ""; }
            }

            if root.page == "ethernet" && root.adapters.length == 0: Rectangle {
                height: 80px;
                Hint { text: "No Ethernet adapter found"; }
            }

            if root.page == "ethernet": VerticalLayout {
                spacing: 8px;
                for a in root.adapters: Rectangle {
                    border-radius: 12px;
                    background: Theme.surface;
                    height: eth.preferred-height;
                    eth := HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 10px;
                                background: a.connected ? Theme.accent : Theme.surface-hover;
                                Glyph {
                                    text: "\u{E839}";
                                    font-size: 15px;
                                    color: a.connected ? Theme.on-accent : Theme.foreground-dim;
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Label {
                                text: a.name;
                                font-weight: 700;
                            }
                            Hint {
                                text: a.connected ? (a.speed != "" ? "Connected · " + a.speed : "Connected") : "Cable unplugged";
                                color: a.connected ? Theme.accent : Theme.foreground-dim;
                            }
                            if a.ipv4 != "": Hint { text: "IPv4 " + a.ipv4; }
                            Hint { text: a.description; }
                        }
                    }
                }
            }

            if root.page == "ethernet": HorizontalLayout {
                alignment: end;
                spacing: 8px;
                PillButton {
                    text: "Adapter options";
                    icon: "\u{E839}";
                    clicked => { root.adapter-options(); }
                }
                PillButton {
                    text: "Ethernet settings";
                    icon: "\u{E713}";
                    clicked => { root.ethernet-settings(); }
                }
            }
        }
    }
}
